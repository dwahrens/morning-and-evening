{
  "name": "pwa-morning-and-evening",
  "version": "0.0.1",
  "description": "A PWA of Spurgeon's wonderful devotional: Morning & Evening.",
  "main": "app.js",
  "scripts": {
    "css-build": "sass --load-path=node_modules sass/me.scss:./public/css/bulma.css",
    "css-build-min": "sass --load-path=node_modules --style=compressed sass/me.scss:./public/css/bulma.min.css",
    "css-watch": "npm run css-build -- --watch",
    "start": "node app.js",
    "develop": "nodemon -e js,ejs,html,scss,css app.js"
  },
  "keywords": [
    "Morning",
    "Evening",
    "PWA",
    "Charles",
    "Spurgeon",
    "Daily",
    "Devotional"
  ],
  "author": "Drew Ahrens",
  "license": "Apache-2.0",
  "dependencies": {
    "bulma": "^1.0.4",
    "dotenv": "^16.0.1",
    "ejs": "^3.1.8",
    "express": "^4.18.1",
    "express-useragent": "^1.0.15",
    "fs": "0.0.1-security",
    "helmet": "^5.1.1",
    "nodemon": "^3.1.11",
    "path": "^0.12.7",
    "sass": "^1.58.3"
  }
}
